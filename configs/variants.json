    },
    "ksu-susfs-bbg-droidspaces": {
      "description": "KernelSU, SUSFS, BBG, and Droidspaces build.",
      "features": ["ksu", "susfs", "bbg", "droidspaces"],
      "ak3_suffixes": ["KSU", "SUSFS", "BBG", "DROIDSPACES"]
    }
  }
